# Synapse Configuration File
# This file contains all configuration options for the Synapse reverse proxy
# Generated by Ansible - do not edit manually
#
# Environment Variable Overrides:
# All configuration options can be overridden using environment variables with the AX_ prefix.
# For example: AX_MODE=proxy or AX_SERVER_UPSTREAM=http://localhost:8080

# Application operating mode
# - agent: Only access rules and monitoring (no proxy)
# - proxy: Full reverse proxy functionality (default)
{% set synapse_mode = synapse_config_mode | default('agent') %}
mode: {{ synapse_mode | quote }}

# Network Configuration
network:
  # The network interface to attach the XDP program to
  # Automatically detects primary interface from ansible_facts['default_ipv4']['interface'] if not specified
  iface: {{ synapse_config_network_iface | default(ansible_facts['default_ipv4']['interface'] | default('eth0')) | quote }}
  # Additional network interfaces for XDP attach (overrides iface if set)
  ifaces: {{ synapse_config_network_ifaces | default([]) | to_json }}
  # IP version support mode: "ipv4", "ipv6", or "both" (default: "both")
  ip_version: {{ synapse_config_network_ip_version | default('both') | quote }}

# Gen0Sec platform configuration
platform:
  # API key for Gen0Sec service
  api_key: {{ synapse_config_platform_api_key | default('') | quote }}
  # Base URL for Gen0Sec API
  base_url: {{ synapse_config_platform_base_url | default('https://api.gen0sec.com/v1') | quote }}
  # Enable sending access logs to the platform
  telemetry_sending_enabled: {{ synapse_config_platform_telemetry_sending_enabled | default(true) | lower }}
  # Include response body in access logs
  include_response_body: {{ synapse_config_platform_include_response_body | default(true) | lower }}
  # Maximum size for request/response bodies in access logs (bytes)
  max_body_size: {{ synapse_config_platform_max_body_size | default(1048576) }}
  # Threat MMDB Configuration
  threat:
    url: {{ synapse_config_platform_threat_url | default('https://download.gen0sec.com/v1') | quote }}
    path: {{ synapse_config_platform_threat_path | default('/var/lib/synapse') | quote }}
    headers: {{ synapse_config_platform_threat_headers | default(None) | to_json }}
    refresh_secs: {{ synapse_config_platform_threat_refresh_secs | default(300) }}
{% if synapse_mode != 'agent' %}
  # GeoIP MMDB Configuration
  # Synapse ships with the IPinfo Lite bundle: one database carries both
  # country and ASN, so `asn` and `city` are unused (empty) by default.
  geoip:
    country:
      url: {{ synapse_config_geoip_country_url | default('https://github.com/gen0sec/geoip-databases/raw/download/ipinfo_lite.mmdb') | to_json }}
      path: {{ synapse_config_geoip_country_path | default('/var/lib/synapse/ipinfo_lite.mmdb') | to_json }}
      headers: {{ synapse_config_geoip_country_headers | default(None) | to_json }}
    asn:
      url: {{ synapse_config_geoip_asn_url | default('') | to_json }}
      path: {{ synapse_config_geoip_asn_path | default('') | to_json }}
      headers: {{ synapse_config_geoip_asn_headers | default(None) | to_json }}
    city:
      url: {{ synapse_config_geoip_city_url | default('') | to_json }}
      path: {{ synapse_config_geoip_city_path | default('') | to_json }}
      headers: {{ synapse_config_geoip_city_headers | default(None) | to_json }}
    refresh_secs: {{ synapse_config_geoip_refresh_secs | default(28800) }}
{% endif %}

# Logging Configuration
logging:
  level: {{ synapse_config_logging_level | default('info') | quote }}
  # Unified fingerprint / BPF event log (replaces the per-type bpf_stats,
  # tcp_fingerprint, ... switches, which the loader now ignores)
  fingerprint_log:
    enabled: {{ synapse_config_logging_fingerprint_log_enabled | default(true) | lower }}
{% if synapse_config_logging_fingerprint_log_file is defined %}
    file: {{ synapse_config_logging_fingerprint_log_file | to_json }}
{% endif %}

# Daemon Configuration
daemon:
  enabled: {{ synapse_config_daemon_enabled | default(true) | lower }}
  pid_file: {{ synapse_config_daemon_pid_file | default('/var/run/synapse.pid') | quote }}
  working_directory: {{ synapse_config_daemon_working_directory | default('/var/lib/synapse') | quote }}
  user: {{ synapse_config_daemon_user | default('root') | to_json }}
  group: {{ synapse_config_daemon_group | default('root') | to_json }}
  chown_pid_file: {{ synapse_config_daemon_chown_pid_file | default(true) | lower }}

{% if synapse_mode != 'agent' %}
# Proxy Configuration (proxy mode only)
proxy:
  address_http: {{ synapse_config_proxy_address_http | default('0.0.0.0:80') | quote }}
  address_tls: {{ synapse_config_proxy_address_tls | default('0.0.0.0:443') | quote }}
  certificates: {{ synapse_config_proxy_certificates | default('/etc/synapse/certs') | quote }}
  tls_grade: {{ synapse_config_proxy_tls_grade | default('medium') | quote }}
  default_certificate: {{ synapse_config_proxy_default_certificate | default('default') | quote }}
  # Redis Configuration (ACME certificate cache)
  redis:
    # Redis connection URL for ACME cache storage. Empty (no Redis) when the
    # role does not install Redis, unless synapse_config_redis_url points at
    # an existing one.
    url: {{ synapse_config_redis_url | default('redis://127.0.0.1/0' if redis_enabled | bool else '') | to_json }}
    # Namespace prefix for Redis ACME cache entries
    prefix: {{ synapse_config_redis_prefix | default('g0s:synapse') | quote }}
{% if synapse_config_redis_ssl is defined and synapse_config_redis_ssl %}
    # Redis SSL/TLS configuration
    ssl:
{% if synapse_config_redis_ssl_ca_cert_path is defined %}
      ca_cert_path: {{ synapse_config_redis_ssl_ca_cert_path | to_json }}
{% endif %}
{% if synapse_config_redis_ssl_client_cert_path is defined %}
      client_cert_path: {{ synapse_config_redis_ssl_client_cert_path | to_json }}
{% endif %}
{% if synapse_config_redis_ssl_client_key_path is defined %}
      client_key_path: {{ synapse_config_redis_ssl_client_key_path | to_json }}
{% endif %}
{% if synapse_config_redis_ssl_insecure is defined %}
      insecure: {{ synapse_config_redis_ssl_insecure | lower }}
{% endif %}
{% endif %}
  upstream:
    conf: {{ synapse_config_proxy_upstream_conf | default('/etc/synapse/upstreams.yaml') | quote }}
    healthcheck:
      method: {{ synapse_config_proxy_upstream_healthcheck_method | default('HEAD') | quote }}
      interval: {{ synapse_config_proxy_upstream_healthcheck_interval | default(2) }}
  protocol:
    enabled: {{ synapse_config_proxy_protocol_enabled | default(false) | lower }}
    timeout_ms: {{ synapse_config_proxy_protocol_timeout_ms | default(1000) }}
  # Captcha Configuration
  captcha:
    site_key: {{ synapse_config_captcha_site_key | default(None) | to_json }}
    secret_key: {{ synapse_config_captcha_secret_key | default(None) | to_json }}
    jwt_secret: {{ synapse_config_captcha_jwt_secret | default(None) | to_json }}
    provider: {{ synapse_config_captcha_provider | default('hcaptcha') | quote }}
    token_ttl: {{ synapse_config_captcha_token_ttl | default(7200) }}
    cache_ttl: {{ synapse_config_captcha_cache_ttl | default(300) }}
  # Content scanning (ClamAV).
  # Enabling it only stands up the ClamAV client; a WAF rule with
  # `action: content_scanning` selects which requests are actually scanned.
  # With no such rule loaded, nothing is scanned.
  content_scanning:
    enabled: {{ synapse_config_content_scanning_enabled | default(false) | lower }}
    clamav_server: {{ synapse_config_content_scanning_clamav_server | default('localhost:3310') | quote }}
    max_file_size: {{ synapse_config_content_scanning_max_file_size | default(10485760) }}
    # block (default) refuses an uninspectable body with 413; pass forwards it
    # unscanned.
    unscannable: {{ synapse_config_content_scanning_unscannable | default('block') }}
  # ACME Configuration (Let's Encrypt certificate management)
  acme:
    enabled: {{ synapse_config_acme_enabled | default(false) | lower }}
    port: {{ synapse_config_acme_port | default(9180) }}
    email: {{ synapse_config_acme_email | default(None) | to_json }}
    storage_type: {{ synapse_config_acme_storage_type | default(None) | to_json }}
    storage_path: {{ synapse_config_acme_storage_path | default('/var/lib/synapse/acme') | quote }}
    development: {{ synapse_config_acme_development | default(false) | lower }}
    redis_url: {{ synapse_config_acme_redis_url | default(None) | to_json }}
{% endif %}
