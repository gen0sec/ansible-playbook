# Ubuntu 20.04 with systemd as PID 1, and ansible-core to run the playbook from
# inside it (connection: local). Ubuntu 20.04 ships Python 3.8, which recent
# ansible-core cannot run on as the controller, so ansible lives in a Python
# 3.9 venv; the modules still run on the system python3 (which has python3-apt).
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive container=docker
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus iproute2 sudo ca-certificates \
      python3 python3-apt python3.9 python3.9-venv \
 && rm -rf /var/lib/apt/lists/* \
 && python3.9 -m venv /opt/ansible \
 && /opt/ansible/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/ansible/bin/pip install --no-cache-dir 'ansible-core>=2.15,<2.16'
ENV PATH=/opt/ansible/bin:$PATH
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
